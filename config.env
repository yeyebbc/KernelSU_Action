# H8116 Xperia XZ2 Premium (aurora) dedicated manual kernel build.
# Sourced by .github/workflows/build-kernel.yml. Must remain valid bash.
# No AnyKernel; boot image is repacked with AOSP mkbootimg + AVB.

# --- Kernel source (LineageOS 22.2, Sony SDM845) ---
KERNEL_SOURCE="https://github.com/LineageOS/android_kernel_sony_sdm845"
KERNEL_SOURCE_BRANCH="lineage-22.2"
# Pinned commit: HEAD of lineage-22.2 (2026-09-07). Makefile reports 4.9.337.
KERNEL_SOURCE_COMMIT="1a8fc01dce4296fc3d5437dc4f2a713ecec621e9"

KERNEL_CONFIG="tama_aurora_defconfig"
KERNEL_IMAGE_NAME="Image.gz-dtb"
ARCH="arm64"
# Expected kernel release string: 4.9.337 + LOCALVERSION="-perf+", SCM suffix suppressed.
EXPECTED_KERNEL_RELEASE="4.9.337-perf+"

# --- AOSP clang (matches original compiler clang r536225 = clang 19.0.1) ---
# clang-r536225 is NOT in the frozen kernel-build-* branches (they carry
# r450784e/r487747c/r510928); it lives on the master branch.
CLANG_SOURCE="https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86"
CLANG_BRANCH="master"
CLANG_RELEASE="clang-r536225"
# --target= strips the trailing '-'; must NOT be aarch64-linux-android (clang-android.sh
# rejects __ANDROID__). GCC provides binutils (as/ld) + compat vDSO 32-bit toolchain.
CLANG_TRIPLE="aarch64-linux-gnu-"
LINKER="ld.lld"

# --- AOSP GCC prebuilts (binutils + compat vDSO toolchains) ---
GCC_64_SOURCE="https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9"
GCC_32_SOURCE="https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9"
GCC_TAG="android-12.1.0_r27"
GCC_64_PREFIX="aarch64-linux-android-"
GCC_32_PREFIX="arm-linux-androideabi-"

# --- backslashxx KernelSU fork (built-in syscall hooks; no legacy patches) ---
KSU_SOURCE="https://github.com/backslashxx/KernelSU"
# Pinned commit: HEAD of master (2026-09-07). setup.sh is run with this exact commit.
KSU_COMMIT="ddd29e922d379e9f4574fd6e1112adf42b3dbe5b"
# 4.9 recommendation: tamper syscall table + LSM security hooks + KSU.
# KSU defaults y, KSU_LSM_SECURITY_HOOKS defaults y, KSU_TAMPER_SYSCALL_TABLE defaults n -> enable explicitly.
KSU_FLAGS=(
  KSU
  KSU_TAMPER_SYSCALL_TABLE
  KSU_LSM_SECURITY_HOOKS
)

# --- AOSP mkbootimg + avb (android15-release) ---
MKBOOTIMG_SOURCE="https://android.googlesource.com/platform/system/tools/mkbootimg"
AVB_SOURCE="https://android.googlesource.com/platform/external/avb"
TOOLS_BRANCH="android15-release"
MKBOOTIMG_COMMIT="c40a04c0620c5a0dab87497857805b8d9b8a827a"  # HEAD of android15-release
AVB_COMMIT="25a14f7e3e6493a7f1a42aa9f78209d4dbe848e9"        # HEAD of android15-release

# --- Reference boot/DTBO images (committed inputs, never modified) ---
SOURCE_BOOT_IMAGE="h8116-lineage/boot.img"
SOURCE_DTBO_IMAGE="h8116-lineage/dtbo.img"

# --- Boot image packaging paths ---
PACKAGING_TOOLS="kernel_workspace/tools"
PACKAGING_AVBTOOL="kernel_workspace/avb/avbtool.py"
PACKAGING_KERNEL="kernel_workspace/android-kernel/out/arch/${ARCH}/boot/${KERNEL_IMAGE_NAME}"
PACKAGING_OUTPUT="kernel_workspace/dist/boot.img"
