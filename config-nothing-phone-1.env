# Nothing Phone (1) Spacewar, Nothing OS 2.0.5 / Android 13.
# Sourced by .github/workflows/build-nothing-phone-1.yml; valid Bash.

KERNEL_SOURCE="https://github.com/NothingOSS/android_kernel_msm-5.4_nothing_sm7325"
KERNEL_SOURCE_BRANCH="sm7325/t"
# Nothing's published OS 2.0.5.A063 source commit. The stock gcfce8884187a
# suffix does not identify a commit present in this public repository.
KERNEL_SOURCE_COMMIT="52ab7e4cf7d03d9b47195a5bcb18f5be32b11ab2"
KERNEL_IMAGE_NAME="Image"
ARCH="arm64"
EXPECTED_KERNEL_RELEASE="5.4.210-qgki-gcfce8884187a"
LOCALVERSION_SUFFIX="-qgki-gcfce8884187a"

# Matches the compiler recorded in the supplied Nothing OS 2.0.5 boot image.
CLANG_SOURCE="https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86"
CLANG_TRIPLE="aarch64-linux-gnu-"
CLANG_BRANCH="android11-qpr2-release"
CLANG_RELEASE="clang-r383902b1"

# GNU binutils provide Clang's target/prefix discovery; LLVM's integrated
# assembler and LLVM binutils perform the actual kernel build.
GCC_64_SOURCE="https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9"
GCC_32_SOURCE="https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9"
GCC_TAG="android-11.0.0_r48"
GCC_64_PREFIX="aarch64-linux-androidkernel-"
GCC_32_PREFIX="arm-linux-androideabi-"

KSU_SOURCE="https://github.com/backslashxx/KernelSU"
KSU_COMMIT="ddd29e922d379e9f4574fd6e1112adf42b3dbe5b"
KSU_FLAGS=(
  KSU
  KSU_HACK_ARM64_BRANCH_LINK
  KSU_LSM_SECURITY_HOOKS
)

MKBOOTIMG_SOURCE="https://android.googlesource.com/platform/system/tools/mkbootimg"
AVB_SOURCE="https://android.googlesource.com/platform/external/avb"
MKBOOTIMG_COMMIT="6cb944b82c819b691bc21d8228e155f1db07a446"
AVB_COMMIT="8261ecd67956f6e9647ff5fd4aeb829f75fb3f66"

SOURCE_BOOT_IMAGE="nothing-1-2.0.5/boot.img"
SOURCE_DTBO_IMAGE="nothing-1-2.0.5/dtbo.img"
PACKAGING_TOOLS="nothing_workspace/tools"
PACKAGING_AVBTOOL="nothing_workspace/avb/avbtool.py"
PACKAGING_KERNEL="nothing_workspace/android-kernel/out/arch/${ARCH}/boot/${KERNEL_IMAGE_NAME}"
PACKAGING_OUTPUT="nothing_workspace/dist/boot.img"
